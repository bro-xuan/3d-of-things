{
  "name": "3d-of-things",
  "private": true,
  "version": "0.1.0",
  "description": "A free, browser-based library of machines you can take apart in 3D.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "models:fetch": "node scripts/fetch-models.mjs",
    "models:build": "node scripts/build-models.mjs",
    "models:inspect": "node scripts/inspect-model.mjs",
    "posters": "node scripts/capture-posters.mjs",
    "new": "node scripts/new-object.mjs",
    "check": "node scripts/check-content.mjs",
    "qa": "node scripts/qa/run.mjs",
    "timing": "node scripts/timing.mjs",
    "truth": "node scripts/truth-tables.mjs",
    "export": "node scripts/export-site.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "meshoptimizer": "~1.2.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
