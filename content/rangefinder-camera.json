  "annotations": [
    {
      "title": "Rangefinder window",
      "text": "The small window sees the subject from 68.5 mm to the side of the viewfinder. A prism behind it sends that view across the camera to the eyepiece, where it appears as a bright patch in the middle of the finder.",
