  "parts": [
    {
      "node": "lens",
      "label": "Lens mount",
      "group": "Lens",
      "about": "The bayonet that locks the lens to the camera, with the depth-of-field scale on its fixed ring. Everything else in the lens turns or slides inside it.",
      "direction": [
        0,
        0,
        1
      ],
      "distance": 0.5,
      "window": [
        0,
        0.2
      ]
    },
    {
      "node": "focus_ring",
      "label": "Focusing ring",
      "group": "Lens",
      "about": "Turns a fine thread (a helicoid) that screws the optical unit forward: 4.5 mm out for the nearest focus, 0.7 m. The distance scale is printed on it.",
      "direction": [
        0,
        1,
        0
      ],
      "distance": 0
    },
    {
      "node": "aperture_ring",
      "label": "Aperture ring",
      "group": "Lens",
      "about": "Sets the iris, from f/1.4 wide open to f/16. Each click lets in half the light of the one before.",
      "direction": [
        0,
        1,
        0
      ],
      "distance": 0
    },
    {
      "node": "hood",
      "label": "Lens hood",
      "group": "Lens",
      "about": "A short tube that keeps stray light from glancing into the front glass.",
      "direction": [
        0,
        0,
        1
      ],
      "distance": 0.17,
      "window": [
        0.72,
        0.9
      ]
    },
    {
      "node": "optics",
      "label": "Optical unit",
      "group": "Lens",
      "about": "Eight glass elements in a barrel. They bend the light from each point of the subject back to a point on the film, making the picture.",
      "direction": [
        0,
        1,
        0
      ],
      "distance": 0
    },
    {
      "node": "iris_blade_0",
      "with": [
        "iris_blade_1",
        "iris_blade_2",
        "iris_blade_3",
        "iris_blade_4",
        "iris_blade_5",
        "iris_blade_6",
        "iris_blade_7",
        "iris_blade_8",
        "iris_ring"
      ],
      "label": "Iris",
      "group": "Lens",
      "about": "Nine thin blades on pins. Turning the aperture ring swings them in together, closing a round hole in the middle of the lens.",
      "direction": [
        0,
        1,
        0
      ],
      "distance": 0
    },
    {
      "node": "rf_cam",
      "label": "Rangefinder cam",
      "group": "Lens",
      "about": "A curved face on the back of the optical unit. As the lens comes forward to focus close, it pushes the camera’s roller with it.",
      "direction": [
        0,
        1,
        0
      ],
      "distance": 0
    },
    {
      "node": "rangefinder",
      "label": "Rangefinder optics",
      "group": "Rangefinder",
      "about": "The prism behind the small window sends its view across the camera to a beam splitter behind the eyepiece, which lays it over the main view as a bright patch.",
      "direction": [
        0,
        1,
        0
      ],
      "distance": 0
    },
    {
      "node": "roller_lever",
      "label": "Roller arm",
      "group": "Rangefinder",
      "about": "Rides on the lens’s cam. As the lens comes forward the arm turns on its shaft, and the same shaft swings the moving lens above.",
      "direction": [
        0,
        1,
        0
      ],
      "distance": 0
    },
    {
      "node": "swinging_lens",
      "label": "Moving lens",
      "group": "Rangefinder",
      "about": "A small lens in the rangefinder’s beam. Swung a millimetre aside, it tilts the second view by up to 5.6°, which is what slides the patch’s image across.",
      "direction": [
        0,
        1,
        0
      ],
      "distance": 0
    },
    {
      "node": "frame_mask",
      "label": "Frame-line mask",
      "group": "Rangefinder",
      "about": "A plate with the outline of the picture cut in it. Light from the frosted window shines through, so a bright frame floats in the viewfinder, and the mask shifts as you focus to allow for the finder sitting above the lens.",
      "direction": [
        0,
        1,
        0
      ],
      "distance": 0
    },
    {
      "node": "shutter",
      "label": "Shutter",
      "group": "Shutter",
      "about": "A frame holding the curtains’ rollers just in front of the film, and the gate: the 24 × 36 mm opening that sets the size of each picture.",
      "direction": [
        0,
        0,
        -1
      ],
      "distance": 0.28,
      "window": [
        0.58,
        0.8
      ]
    },
    {
      "node": "first_curtain",
      "label": "First curtain",
      "group": "Shutter",
      "about": "Covers the film until the shutter fires, then is pulled clear by its spring roller in under a fiftieth of a second.",
      "direction": [
        0,
        1,
        0
      ],
      "distance": 0
    },
    {
      "node": "second_curtain",
      "label": "Second curtain",
      "group": "Shutter",
      "about": "Follows the first one across, after a delay set by the speed dial, and covers the film again. The gap between them is the exposure.",
      "direction": [
        0,
        1,
        0
      ],
      "distance": 0
    },
