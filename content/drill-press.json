  "annotations": [
    {
      "title": "Motor",
      "text": "An induction motor at the back runs at one fixed speed, typically around 1,400 rpm. The pulleys turn that single speed into several.",
      "position": [
        0.046,
        1.152,
        -0.457
      ],
      "camera": {
        "position": [
          1.319,
          1.534,
          -1.348
        ],
        "target": [
          0.046,
          1.152,
          -0.457
        ]
      }
    },
    {
      "title": "Stepped pulleys",
      "text": "Each pulley is a stack of grooves of different diameters, one on the motor and a mirror-image one on the spindle. Their ratio sets the speed: a 2 : 1 pair halves it and doubles the turning force.",
      "node": "drill_press_01_gear_b",
      "position": [
        0.047,
        1.3,
        0.312
      ],
      "camera": {
        "position": [
          0.501,
          2.436,
          0.993
        ],
        "target": [
          0.047,
          1.3,
          0.312
        ]
      }
    },
    {
      "title": "V-belt",
      "text": "The belt's wedge-shaped section jams into the pulley grooves, so the harder it pulls, the tighter it grips. To change speed you lift the guard and move it to another pair of grooves.",
      "node": "drill_press_01_belt",
      "position": [
        0.092,
        1.225,
        -0.002
      ],
      "camera": {
        "position": [
          0.954,
          2.374,
          0.429
        ],
        "target": [
          0.092,
          1.225,
          -0.002
        ]
      }
    },
    {
      "title": "Feed handles",
      "text": "The handles turn a small gear meshed with teeth cut into the sleeve around the spindle: a rack and pinion. Pull down and the spinning bit descends; let go and a spring lifts it back.",
      "node": "drill_press_01_handle",
      "position": [
        0.241,
        0.974,
        0.234
      ],
      "camera": {
        "position": [
          1.404,
          1.323,
          0.932
        ],
        "target": [
          0.241,
          0.974,
          0.234
        ]
      }
    },
    {
      "title": "Depth stop",
      "text": "A stop on a threaded rod limits how far the spindle can travel, so a whole batch of holes ends at exactly the same depth.",
      "node": "drill_press_01_limiter",
      "position": [
        -0.013,
        0.995,
        0.326
      ],
      "camera": {
        "position": [
          -0.244,
          1.226,
          1.481
        ],
        "target": [
          -0.013,
          0.995,
          0.326
        ]
      }
    },
    {
      "title": "Table",
      "text": "The table slides up and down the column and locks with a clamp. Its slots let the bit pass through without hitting the table and give clamps something to grip.",
